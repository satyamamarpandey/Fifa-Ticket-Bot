# ----------------------------------------------------------------------------
# FIFA Ticket Monitor — environment template
# Copy this file to ".env" and fill in real values:   cp .env.example .env
# ----------------------------------------------------------------------------

# ===== Target / source configuration ========================================
# The endpoint the monitor scans. Defaults to the bundled mock server.
# For a NO-tickets page use ".../" ; to simulate a live drop use ".../drop".
TARGET_URL=http://localhost:4040/

# Port the local mock server (mockServer.js) listens on.
MOCK_PORT=4040

# ===== Match / rules configuration ==========================================
# We only ever care about Match 104 — The Final.
TARGET_MATCH_ID=104
TARGET_MATCH_NAME=The Final

# The ONLY sale channel treated as primary retail. Anything else (Resale,
# Verified Fan Resale, Hospitality, ...) is discarded.
PRIMARY_SALE_TYPE=Primary

# Budget ceiling applied to the FACE value (the listed ticket price, before the
# 15% service fee). The default $4,300 admits Category 2 ($4,210 face) while
# excluding the dynamically-priced Category 1 ($6,730+).
PRICE_CAP=4300

# "Ping me when the price comes around $X" mode. Set TARGET_PRICE to a number
# (e.g. 2000) and the monitor alerts on ANY primary listing whose price lands
# within +/- TARGET_PRICE_TOLERANCE_PCT of it, ignoring category/base-rate
# rules. Leave at 0 to use the category/budget rules above instead.
#   Example: TARGET_PRICE=2000 with 0.10 tolerance => alerts on $1,800-$2,200.
TARGET_PRICE=0
TARGET_PRICE_TOLERANCE_PCT=0.10

# Official FIFA 2026 Final (Match 104) primary face-value base rates by
# category, in USD. A genuine primary seat must sit within DEVIATION_TOLERANCE
# of its category's base rate; a "primary" listing priced outside that band is
# treated as a mis-flagged resale and discarded.
#   Real published values: Cat 1 $6,730+ (dynamic), Cat 2 $4,210,
#   Cat 3 $2,790, Cat 4 $2,030.
# Category 1 is omitted by default because it is dynamically priced and above a
# typical budget. Add it here if you want to monitor it (and raise PRICE_CAP).
OFFICIAL_BASE_RATES={"Category 2":4210,"Category 3":2790,"Category 4":2030}

# Allowed +/- deviation around a category base rate (0.05 = 5%). Fixed-price
# categories (2/3/4) stay tight; widen this if you add dynamic Category 1.
DEVIATION_TOLERANCE_PCT=0.05

# FIFA checkout service fee (0.15 = 15%). Informational: shown in the alert as
# the estimated total, not applied to the cap/base-rate checks.
SERVICE_FEE_PCT=0.15

# ISO currency code expected on the listing (display only).
CURRENCY=USD

# ===== Scheduler ============================================================
FETCH_INTERVAL_SECONDS=60      # how often to poll the target
SUMMARY_INTERVAL_SECONDS=600   # heartbeat summary cadence (default 10 min)
FETCH_TIMEOUT_SECONDS=15       # per-request timeout
FETCH_RETRIES=3                # retries per cycle with exponential backoff

# ===== Logging ==============================================================
# debug | info | warn | error  (debug prints per-listing rejection reasons)
LOG_LEVEL=info

# ===== SMTP / email dispatch (Nodemailer) ===================================
# If SMTP_HOST/USER/PASS are left blank, the monitor automatically falls back
# to Nodemailer's "jsonTransport" so the alert is printed to the console
# instead of being sent. This keeps the project fully testable offline.
# Set all three together, or none.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Envelope addresses for the alert email.
ALERT_FROM="FIFA Ticket Monitor <monitor@example.com>"
ALERT_TO=you@example.com

# Force console-only delivery even if SMTP creds are present (true/false).
DRY_RUN=false
